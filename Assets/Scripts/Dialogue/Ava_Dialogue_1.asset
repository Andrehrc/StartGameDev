  m_Script: {fileID: 11500000, guid: 7e659d078c00c5f4697a7a76572834c7, type: 3}
  m_Name: Ava_Dialogue_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSettings
  actor: {fileID: 9065983279404047286, guid: 18d0e38003d40554e9c2b580fdbe4952, type: 3}
  speakerStripe: {fileID: 0}
  sentence: 
  dialogues:
  - actorName: Ava
    profile: {fileID: -1940738496428130850, guid: 507ddeadcf05c3b46bc5c8d5f49468f5, type: 3}
    sentence:
      portugues: "Ol\xE1, querido! Bem vindo a vila. Meu Nome \xE9 Ava"
      english: ' Hello, dear! Welcome to the village. My name is Ava.'
      espanol: " \xA1Hola, querida! Bienvenida al pueblo. Me llamo Ava."
  - actorName: Ava
    profile: {fileID: -1940738496428130850, guid: 507ddeadcf05c3b46bc5c8d5f49468f5, type: 3}
    sentence:
      portugues: "Voc\xEA pode coletar madeiras no bosque acima. Tamb\xE9m pode plantar
        cenouras em nossa fazenda a oeste, mas n\xE3o se esque\xE7a de pegar agua
        para regar a planta\xE7\xE3o."
      english: 'You can collect wood in the woods above. You can also plant carrots
        on our farm to the west, but don''t forget to get water to irrigate the plants. '
      espanol: "Puedes recoger madera en el bosque de arriba. Tambi\xE9n puedes plantar
        zanahorias en nuestra granja al oeste, pero no olvides conseguir agua para
        regarlas. "
  - actorName: Ava
    profile: {fileID: -1940738496428130850, guid: 507ddeadcf05c3b46bc5c8d5f49468f5, type: 3}
    sentence:
      portugues: "Para utilizar suas ferramentas, utilize a tecla Q, e para rolar,
        utilize o bot\xE3o direito do mouse. Ap\xF3s coletar madeira, voc\xEA pode
        construir uma casa no local abaixo de n\xF3s."
      english: ' To use your tools, press the Q key, and to scroll, use the right
        mouse button. After collecting wood, you can build a house in the area below
        us.'
      espanol: " Para usar tus herramientas, pulsa la tecla Q, y para desplazarte,
        usa el bot\xF3n derecho del rat\xF3n. Tras recoger madera, podr\xE1s construir
        una casa en la zona que hay debajo."
  - actorName: Ava
    profile: {fileID: -1940738496428130850, guid: 507ddeadcf05c3b46bc5c8d5f49468f5, type: 3}
    sentence:
      portugues: "Sua tecla de a\xE7\xE3o \xE9 sempre a tecla E, e voc\xEA pode usar
        o Shift para correr."
      english: 'Your action key is always the E key, and you can use Shift to run. '
      espanol: "La tecla de acci\xF3n siempre es la tecla E, y puedes usar Shift
        para correr. "
  - actorName: Ava
    profile: {fileID: -1940738496428130850, guid: 507ddeadcf05c3b46bc5c8d5f49468f5, type: 3}
    sentence:
      portugues: "Ah, e como ultima dica, voc\xEA pode pescar na parte de cima do
        nosso lago. E cuidado com o cemit\xE9rio da vila a sudeste, ele foi tomado
        por esqueletos recentemente."
      english: 'Oh, and as a final tip, you can fish on the upper part of our lake.
        And be careful of the village cemetery to the southeast; it''s been taken
        over by skeletons recently. '
      espanol: "Ah, y como \xFAltimo consejo, pueden pescar en la parte alta de nuestro
        lago. Y tengan cuidado con el cementerio del pueblo, al sureste; \xFAltimamente
        est\xE1 lleno de esqueletos. "
